{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calliope.chess/schema/calliope_view_v1.json",
  "title": "calliope_view_v1",
  "description": "The board's document of the MCP App (AG6-D §6.1): the whole game, every ply's state, the analysis job, and a calliope_result_v1 of the analysed plies of a range, or none.",
  "type": "object",
  "required": ["schema", "game", "result", "plies", "job", "omitted"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "calliope_view_v1"},
    "game": {
      "type": "object",
      "required": ["start_fen", "moves", "headers"],
      "additionalProperties": false,
      "properties": {
        "start_fen": {"type": "string"},
        "moves": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["san", "uci"],
            "additionalProperties": false,
            "properties": {"san": {"type": "string"}, "uci": {"type": "string"}}
          }
        },
        "headers": {"type": "object"}
      }
    },
    "result": {
      "anyOf": [{"type": "null"}, {"$ref": "https://calliope.chess/schema/calliope_result_v1.json"}]
    },
    "plies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ply", "state"],
        "additionalProperties": false,
        "properties": {
          "ply": {"type": "integer", "minimum": 1},
          "state": {"enum": ["analysed", "pending", "failed", "none"]},
          "omitted": {"enum": ["record", "commentary"]}
        }
      }
    },
    "job": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["state", "plies", "done", "total", "cached", "analysed", "failed_plies"],
          "properties": {
            "state": {"enum": ["queued", "running", "waiting", "done", "failed", "cancelled"]},
            "plies": {"type": "string"},
            "done": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 0},
            "cached": {"type": "integer", "minimum": 0},
            "analysed": {"type": "integer", "minimum": 0},
            "failed_plies": {"type": "array"},
            "current": {"type": "integer"},
            "seconds_per_ply": {"type": "number"},
            "seconds_left": {"type": "number"},
            "resume_after_seconds": {"type": "integer", "minimum": 1},
            "error": {"type": "string"}
          }
        }
      ]
    },
    "omitted": {
      "type": "object",
      "required": ["records", "commentary"],
      "additionalProperties": false,
      "properties": {
        "records": {"type": "array", "items": {"type": "integer"}},
        "commentary": {"type": "array", "items": {"type": "integer"}}
      }
    }
  }
}
